# StereoSine release-signing template — SAFE TO COMMIT. Contains NO real values.
#
# To sign a release locally:
#   1. Copy this file to  keystore.properties  (that name is gitignored; never commit the copy).
#   2. Replace every placeholder with the values for your UPLOAD key (not the final app key —
#      Google Play App Signing owns the final key once enrolled).
#   3. Keep the keystore file OUTSIDE the repository.
#
# ONE source supplies the whole identity — values are never combined across sources:
#   1. keystore.properties (this file)                       highest precedence
#   2. STEREOSINE_UPLOAD_STORE_FILE / _STORE_PASSWORD / _KEY_ALIAS / _KEY_PASSWORD   (CI secrets)
#   3. WAVDROP_UPLOAD_STORE_FILE / _STORE_PASSWORD / _KEY_ALIAS / _KEY_PASSWORD
#      LEGACY names, retained temporarily for compatibility with existing CI/owner setups. Prefer STEREOSINE_UPLOAD_*.
# A source that supplies some but not all four values fails the build; two complete sources that differ also
# fail the build. Supply none of them to build an unsigned release.
# Details: docs/RELEASE_SIGNING.md.

# Path to the upload keystore: absolute, or relative to the repository root.
# Env var: STEREOSINE_UPLOAD_STORE_FILE
storeFile=/path/to/your-upload-keystore.jks

# Password for the keystore file.
# Env var: STEREOSINE_UPLOAD_STORE_PASSWORD
storePassword=CHANGE_ME

# Alias of the upload key entry inside the keystore.
# Env var: STEREOSINE_UPLOAD_KEY_ALIAS
keyAlias=your-upload-key-alias

# Password for the key entry (often identical to storePassword).
# Env var: STEREOSINE_UPLOAD_KEY_PASSWORD
keyPassword=CHANGE_ME
